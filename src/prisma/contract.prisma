// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model User {
  id             Int          @id @default(autoincrement())
  name           String
  email          String       @unique
  createdAt      TimestamptzString  @default(now())
  updatedAt      temporal.updatedAtString()

  memberships OrganizationMember[]
  createdProjects Project[]
  createdComments Comment[]
  createdAttachments Attachment[]
  createdAuditLogs AuditLog[]
  notifications Notification[]

  createdTasks Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
}

model Organization {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  memberships OrganizationMember[]

  projects Project[]
}

model OrganizationMember{
  id Int @id @default(autoincrement())

  userId Int
  organizationId Int

  user User @relation(fields:[userId], references:[id])
  organization Organization @relation(fields:[organizationId], references:[id])

  @@unique([userId, organizationId]) // The pair should be unique means a user can't be repeat in same organization
  @@map("organization_member")
}

model Project{
  id Int @id @default(autoincrement())
  name String
  description String?
  organizationId Int
  createdByUserId Int
  tasks Task[]
  taskStatuses TaskStatus[]
  labels Label[]
  auditLogs AuditLog[]

  createdByUser User @relation(fields:[createdByUserId],references:[id])
  organization Organization @relation(fields:[organizationId], references:[id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Task{
  id Int @id @default(autoincrement())
  title String 
  description String?

  comments Comment[]
  labels TaskLabel[]
  attachments Attachment[]
  
  projectId Int
  project Project @relation(fields:[projectId], references:[id])

  createdByUserId Int
  createdByUser User @relation("TaskCreator",fields:[createdByUserId], references:[id])

  assignedToUserId Int?
  assignedToUser User? @relation("TaskAssignee",fields:[assignedToUserId], references:[id])

  statusId Int
  status TaskStatus @relation(fields:[statusId], references:[id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model TaskStatus {
  id        Int    @id @default(autoincrement())
  name      String
  position  Int

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  tasks     Task[]

  @@unique([projectId, name])
}

model Comment{
  id Int @id @default(autoincrement())
  content String

  taskId Int
  task Task @relation(fields:[taskId], references:[id])

  createdByUserId Int
  createdByUser User @relation(fields:[createdByUserId], references:[id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Label {
  id        Int    @id @default(autoincrement())
  name      String

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  tasks     TaskLabel[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([projectId, name])
}

model TaskLabel {

   taskId Int
   task Task @relation(fields:[taskId], references:[id])

   labelId Int
   label Label @relation(fields:[labelId], references:[id])

   @@id([taskId, labelId])
}

model Attachment {
  id Int @id @default(autoincrement())

  fileName String
  fileUrl String
  fileSize Int
  mimeType String

  taskId Int
  task Task @relation(fields: [taskId], references: [id])

  createdByUserId Int
  createdByUser User @relation(fields: [createdByUserId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model AuditLog {
  id Int @id @default(autoincrement())

  action String
  entityType String
  entityId Int

  metadata Json?  // for storing the value's like oldValue, newValue

  projectId Int
  project Project @relation(fields: [projectId], references: [id])

  createdByUserId Int
  createdByUser User @relation(fields: [createdByUserId], references: [id])

  createdAt TimestamptzString @default(now())

  @@index([projectId, createdAt])
  @@index([createdByUserId, createdAt])
}

model Notification {
  id Int @id @default(autoincrement())

  type String
  message String
  isRead Boolean @default(false)

  entityType String
  entityId Int

  metadata Json?

  userId Int
  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([userId, isRead, createdAt])
}